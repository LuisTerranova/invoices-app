@inherits LayoutComponentBase

<MudLayout>
    <MudDrawer Open="true" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudAppBar Elevation="1" Class="d-flex align-center pa-4">
            <MudText Typo="Typo.h6" Class="flex-grow-1 ml-4">
                Sistema de Gestão de Notas Fiscais
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Error"
                           Size="Size.Medium" OnClick="HandleLogout"
                           aria-label="Sair" />
        </MudAppBar>
        <MudContainer Class="pa-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
