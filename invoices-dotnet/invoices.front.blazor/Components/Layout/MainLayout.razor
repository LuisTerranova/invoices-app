@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1" Class="px-4">
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Primary" Size="Size.Medium" Class="mr-2" />
            <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Inherit">Gestão de Notas Fiscais</MudText>
        </div>

        <MudSpacer />

        <div class="d-flex align-center">
            <div class="d-flex align-center gap-4">
                <NavLink href="/" Match="NavLinkMatch.All" class="appbar-link">
                    Notas Fiscais
                </NavLink>

                <span class="appbar-separator">|</span>

                <NavLink href="/upload" class="appbar-link">
                    Upload de PDFs
                </NavLink>
            </div>

            <span class="appbar-separator" style="margin: 0 18px;">|</span>

            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="HandleLogout" Class="appbar-sair-btn">
                Sair
            </MudButton>
        </div>
    </MudAppBar>

    <MudMainContent Class="pa-8">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
