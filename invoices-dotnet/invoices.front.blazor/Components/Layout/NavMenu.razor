<MudNavMenu>
    <MudText Typo="Typo.h6" Class="pa-4 white-text" Style="color: #EFE7D8; font-weight: 600;">
        Invoices
    </MudText>

    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Description">
        Notas Fiscais
    </MudNavLink>

    <MudNavLink Href="/upload" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.UploadFile">
        Upload de PDFs
    </MudNavLink>

    <MudDivider Class="my-4" Light="true" />

    <MudText Typo="Typo.body2" Class="px-4" Style="color: #8D8B9A;">
        @if (!string.IsNullOrEmpty(_username))
        {
            <span>@_username</span>
        }
    </MudText>
</MudNavMenu>
