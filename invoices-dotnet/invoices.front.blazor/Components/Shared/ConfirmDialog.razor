@namespace invoices.front.blazor.Components.Shared

<div class="pa-2">
    <MudText Typo="Typo.body1" Class="mb-6" Style="color: var(--mud-palette-text-primary);">
        @Message
    </MudText>
    <div class="d-flex justify-end gap-2">
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">
            Confirmar exclusão
        </MudButton>
    </div>
</div>
