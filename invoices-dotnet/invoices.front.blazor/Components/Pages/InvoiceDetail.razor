@page "/invoices/{Id:guid}"
@attribute [Authorize]
@namespace invoices.front.blazor.Components.Pages

<PageTitle>Detalhe da Nota Fiscal</PageTitle>

<MudText Typo="Typo.h5" Class="mb-6">
    Detalhe da Nota Fiscal
</MudText>

@if (_isLoading)
{
    <MudPaper Elevation="1" Class="pa-6">
        <MudSkeleton Variant="SkeletonVariant.Rectangle" Height="120px" Class="mb-4" />
        <MudSkeleton Variant="SkeletonVariant.Rectangle" Height="200px" />
    </MudPaper>
}
else if (_errorMessage is not null)
{
    <ErrorState Message="@_errorMessage"
                ShowRetry="true"
                OnRetry="LoadInvoice" />
}
else if (_invoice is null)
{
    <EmptyState Icon="@Icons.Material.Filled.Description"
                Message="Nota fiscal não encontrada" />
}
else
{
    <div class="d-flex flex-wrap align-center gap-2 mb-6">
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="GoBack">
            Voltar
        </MudButton>

        @if (_isEditing)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_isSaving"
                       OnClick="HandleSave">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
                }
                <span>Salvar</span>
            </MudButton>
            <MudButton Variant="Variant.Text"
                       OnClick="HandleCancel">
                Cancelar
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="HandleEdit">
                Editar
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Tertiary"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       Disabled="_isOpeningOriginal"
                       OnClick="ViewOriginal">
                @if (_isOpeningOriginal)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
                }
                <span>Ver PDF Original</span>
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="HandleDelete">
                Excluir
            </MudButton>
        }
    </div>

    <MudPaper Elevation="1" Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-4">
            Itens da Nota
        </MudText>

        <div class="d-flex flex-wrap gap-4">
            <MudTextField @bind-Value="_editEstablishment" Label="Estabelecimento"
                          Variant="Variant.Outlined" For="@(() => _editEstablishment)"
                          Class="flex-grow-1 min-w-250" Disabled="!_isEditing" />

            <MudTextField @bind-Value="_editCnpj" Label="CNPJ"
                          Variant="Variant.Outlined" For="@(() => _editCnpj)"
                          Class="flex-grow-1 min-w-200" Disabled="!_isEditing" />

            <MudDatePicker @bind-Date="_editDate" Label="Data"
                           Variant="Variant.Outlined"
                           Class="flex-grow-1 min-w-180"
                           Disabled="!_isEditing" InputFormat="dd/MM/yyyy" />

            <MudNumericField @bind-Value="_editTotal" Label="Total"
                              Variant="Variant.Outlined" For="@(() => _editTotal)"
                              Class="flex-grow-1 min-w-150"
                              Disabled="!_isEditing" Format="C2" />
        </div>

        @if (_invoice.ParseErrors?.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4" Dense="true">
                <strong>Erros de processamento:</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var err in _invoice.ParseErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-4" Style="color: var(--mud-palette-text-primary);">
            Itens
        </MudText>

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="mb-4"
                   Disabled="!_isEditing"
                   OnClick="AddItem">
            Adicionar Item
        </MudButton>

        <MudTable T="ParsedItem"
                  Items="@_editableItems"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh><MudText Typo="Typo.body2">Nome</MudText></MudTh>
                <MudTh><MudText Typo="Typo.body2">Qtd</MudText></MudTh>
                <MudTh><MudText Typo="Typo.body2">Preço Unit.</MudText></MudTh>
                <MudTh><MudText Typo="Typo.body2">Total</MudText></MudTh>
                @if (_isEditing)
                {
                    <MudTh><MudText Typo="Typo.body2">Ações</MudText></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nome" Class="min-w-200">
                    @if (_isEditing)
                    {
                        <MudTextField @bind-Value="context.Name" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Name</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Quantidade">
                    @if (_isEditing)
                    {
                        <MudNumericField @bind-Value="context.Quantity" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Quantity</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Preço Unit.">
                    @if (_isEditing)
                    {
                        <MudNumericField @bind-Value="context.UnitPrice" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Format="C2" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.UnitPrice?.ToString("C2")</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Total">
                    @if (_isEditing)
                    {
                        <MudNumericField @bind-Value="context.Total" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Format="C2" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Total?.ToString("C2")</MudText>
                    }
                </MudTd>
                @if (_isEditing)
                {
                    <MudTd DataLabel="Ações">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => RemoveItem(context)" />
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>

        @if (_editableItems.Count == 0)
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Class="pa-6" Color="Color.Secondary">
                Nenhum item cadastrado.
            </MudText>
        }
    </MudPaper>

    @if (!string.IsNullOrEmpty(_invoice.RawText))
    {
        <MudPaper Elevation="1" Class="pa-6 mb-4">
            <MudText Typo="Typo.h6" Class="mb-4">
                Texto Extraído (OCR)
            </MudText>
            <MudText Typo="Typo.body2" Class="ocr-text-block">
                @_invoice.RawText
            </MudText>
        </MudPaper>
    }
}
