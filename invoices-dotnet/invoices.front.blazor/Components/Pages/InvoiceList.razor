@page "/"
@attribute [Authorize]
@namespace invoices.front.blazor.Components.Pages

<PageTitle>Notas Fiscais</PageTitle>

<MudText Typo="Typo.h5" Class="mb-6">
    Notas Fiscais
</MudText>

@if (_isInitialLoading)
{
    <MudPaper Elevation="1" Class="pa-6">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Class="mb-4" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="32px" Class="mb-2" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="32px" Class="mb-2" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="32px" Class="mb-2" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="32px" />
    </MudPaper>
}
else if (_errorMessage is not null)
{
    <ErrorState Message="@_errorMessage"
                Description="Não foi possível carregar a lista de notas fiscais."
                ShowRetry="true"
                OnRetry="LoadData" />
}
else
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <div class="d-flex flex-wrap align-center gap-4">
            <MudTextField @bind-Value="_searchText"
                          Label="Buscar por estabelecimento, CNPJ ou chave de acesso"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="flex-grow-1 flex-grow-sm-12"
                          Immediate="true"
                          OnKeyUp="HandleSearchKeyUp"
                          Clearable="true"
                          OnClearButtonClick="HandleClearSearch" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="HandleSearch">
                Buscar
            </MudButton>

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           Variant="Variant.Outlined"
                           Size="Size.Large"
                           OnClick="HandleRefresh"
                           title="Atualizar lista" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       Disabled="!_hasSelection"
                       OnClick="OpenDeleteDialog">
                @if (_selectedInvoices.Count > 0)
                {
                    <span>Excluir (@_selectedInvoices.Count)</span>
                }
                else
                {
                    <span>Excluir Selecionados</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Tertiary"
                       Disabled="(!_hasSelection && _selectedGroup is null) || _isExporting"
                       OnClick="HandleExport">
                @if (_isExporting)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
                    <span>Exportando...</span>
                }
                else
                {
                    <span>Exportar Relatório</span>
                }
            </MudButton>
        </div>
    </MudPaper>

    @if (_groups.Count > 0)
    {
        <MudPaper Elevation="1" Class="pa-3 mb-4">
            <div class="d-flex flex-wrap align-center gap-1">
                <MudChip T="string" Text="Todas"
                         Color="@(_selectedGroup is null ? Color.Primary : Color.Default)"
                         Variant="@(_selectedGroup is null ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(e => SelectGroup(null))" />
                @foreach (var group in _groups)
                {
                    var g = group;
                    <MudChip T="string"
                             Text="@g.FullLabel"
                             Color="@(_selectedGroup?.Year == g.Year && _selectedGroup?.Month == g.Month ? Color.Primary : Color.Default)"
                             Variant="@(_selectedGroup?.Year == g.Year && _selectedGroup?.Month == g.Month ? Variant.Filled : Variant.Outlined)"
                             Size="Size.Small"
                             OnClick="@(e => SelectGroup(g))" />
                }
            </div>
        </MudPaper>
    }

    <MudPaper Elevation="1" Class="pa-4">
        @if (_invoices.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.Description"
                        Message="Nenhuma nota fiscal encontrada"
                        Description="Tente ajustar os filtros ou fazer upload de novos PDFs." />
        }
        else
        {
            <MudTable T="Invoice"
                      Items="@_invoices"
                      MultiSelection="true"
                      SelectedItems="_selectedInvoices"
                      SelectedItemsChanged="OnSelectedItemsChanged"
                      OnRowClick="HandleRowClick"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Elevation="0"
                      Class="mb-4">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.body2">Estabelecimento</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.body2">CNPJ</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.body2">Data</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.body2">Total</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.body2">Status</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.body2">Ações</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Estabelecimento" @onclick="() => NavigateToDetail(context)">
                        <MudText Typo="Typo.body2" Color="Color.Primary" Style="cursor: pointer; font-weight: 500;">@context.Establishment?.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="CNPJ" @onclick="() => NavigateToDetail(context)">
                        <MudText Typo="Typo.body2" Style="cursor: pointer;">@context.Establishment?.Cnpj</MudText>
                    </MudTd>
                    <MudTd DataLabel="Data">
                        <MudText Typo="Typo.body2">@context.Date?.ToString("dd/MM/yyyy")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Total">
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.Total?.ToString("C2")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsValid)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">Válida</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Inválida</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Ações">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="() => NavigateToDetail(context)"
                                       title="Visualizar / Editar" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => OpenSingleDeleteDialog(context)"
                                       title="Excluir" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_totalCount nota(s) — Página @_currentPage de @TotalPages
                </MudText>

                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Disabled="!_canGoPrevious"
                               OnClick="GoToPreviousPage">
                        Anterior
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Disabled="!_canGoNext"
                               OnClick="GoToNextPage">
                        Próxima
                    </MudButton>
                </div>
            </div>
        }
    </MudPaper>
}
