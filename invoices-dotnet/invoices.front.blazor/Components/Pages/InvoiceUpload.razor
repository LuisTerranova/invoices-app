@page "/upload"
@attribute [Authorize]
@namespace invoices.front.blazor.Components.Pages

<PageTitle>Upload de PDFs</PageTitle>

<MudText Typo="Typo.h5" Class="mb-6" Style="color: #2D2B36; font-weight: 600;">
    Upload de Notas Fiscais
</MudText>

<MudPaper Elevation="1" Class="pa-6 mb-4">
    <MudFileUpload T="IBrowserFile"
                   Multiple="true"
                   OnFilesChanged="@(files => HandleFilesSelected(files))"
                   AcceptedExtensions=".pdf"
                   Class="mb-4"
                   DragAndDrop="true">
        <CustomContent>
            <div class="d-flex flex-column align-center justify-center pa-8"
                 style="border: 2px dashed #E5DDCD; border-radius: 8px; background: #FAF7F2; cursor: pointer;"
                 @onclick="context.OpenFilePickerAsync">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
                <MudText Typo="Typo.body1" Class="mb-2" Style="color: #3D3B48;">
                    Arraste arquivos PDF aqui ou clique para selecionar
                </MudText>
                <MudText Typo="Typo.body2" Style="color: #6D6B7A;">
                    Apenas arquivos PDF são aceitos
                </MudText>
            </div>
        </CustomContent>
    </MudFileUpload>

    @if (_statusMessage is not null)
    {
        <MudAlert Severity="@(_statusIsError ? Severity.Error : Severity.Success)"
                  Class="mb-4"
                  Dense="true">
            @_statusMessage
        </MudAlert>
    }

    @if (_pendingFiles.Count > 0)
    {
        <MudTable Items="@_pendingFiles" Dense="true" Hover="true" Elevation="0" Class="mb-4">
            <HeaderContent>
                <MudTh>Arquivo</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Arquivo">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Error" />
                        <MudText Typo="Typo.body2">@context.FileName</MudText>
                    </div>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.Error is not null)
                    {
                        <MudText Typo="Typo.body2" Style="color: #D4606A;">@context.Error</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color: #6B8E7A;">Pronto</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Ações">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="() => RemoveFile(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="d-flex align-center gap-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       Disabled="_isUploading"
                       OnClick="HandleUpload">
                @if (_isUploading)
                {
                    <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" Class="mr-2" />
                    <span>Enviando... (@_uploadedCount de @_pendingFiles.Count)</span>
                }
                else
                {
                    <span>Enviar @_pendingFiles.Count arquivo(s)</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="_isUploading"
                       OnClick="ClearFiles">
                Limpar todos
            </MudButton>
        </div>
    }
</MudPaper>
