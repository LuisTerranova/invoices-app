@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="@CustomTheme.Default" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Não encontrado</PageTitle>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <EmptyState Icon="@Icons.Material.Filled.QuestionMark"
                                    Message="Página não encontrada"
                                    Description="A página que você tentou acessar não existe." />
                    </LayoutView>
                </NotFound>
            </Router>
        </Authorized>
        <NotAuthorized>
            <div class="login-page d-flex align-center justify-center">
                <MudGrid Justify="Justify.Center" Class="ma-0 pa-4" Style="width: 100%; max-width: 480px;">
                    <MudItem xs="12">
                        <div class="d-flex flex-column align-center mb-6">
                            <MudIcon Icon="@Icons.Material.Filled.Receipt" Color="Color.Primary" Style="font-size: 3rem;" Class="mb-2" />
                            <MudText Typo="Typo.h5" Color="Color.Inherit" Class="login-title">
                                Gestão de Notas Fiscais
                            </MudText>
                            <MudText Typo="Typo.body2" Class="login-subtitle">
                                Faça login para continuar
                            </MudText>
                        </div>
                        <MudPaper Elevation="8" Class="pa-8">
                            <LoginPage />
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

